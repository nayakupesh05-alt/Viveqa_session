module mcp3202_adc(
    input  wire clk,
    input  wire rst,

    output reg  cs_n,
    output reg  sclk,
    output reg  mosi,
    input  wire miso,

    output reg [11:0] adc_data,
    output reg data_valid
);

reg [4:0] clk_div;
wire spi_tick = (clk_div == 23);

reg [5:0] state;
reg [11:0] shift_reg;
reg [15:0] delay_cnt;

always @(posedge clk or posedge rst)
begin
    if(rst)
    begin
        clk_div    <= 0;
        state      <= 0;
        cs_n       <= 1;
        sclk       <= 0;
        mosi       <= 0;
        adc_data   <= 0;
        shift_reg  <= 0;
        data_valid <= 0;
        delay_cnt  <= 0;
    end
    else
    begin
        data_valid <= 0;

        if(spi_tick)
        begin
            clk_div <= 0;

            case(state)

            // Idle
            0:
            begin
                cs_n <= 1;
                sclk <= 0;
                mosi <= 0;

                if(delay_cnt < 1000)
                    delay_cnt <= delay_cnt + 1;
                else
                begin
                    delay_cnt <= 0;
                    state <= 1;
                end
            end

            // Start
            1: begin cs_n<=0; sclk<=0; mosi<=1; state<=2; end
            2: begin sclk<=1; state<=3; end

            // SGL/DIFF=1
            3: begin sclk<=0; mosi<=1; state<=4; end
            4: begin sclk<=1; state<=5; end

            // CH0
            5: begin sclk<=0; mosi<=0; state<=6; end
            6: begin sclk<=1; state<=7; end

            // Don't care
            7: begin sclk<=0; mosi<=0; state<=8; end
            8: begin sclk<=1; state<=9; end

            // Null bit
            9: begin sclk<=0; state<=10; end
            10: begin sclk<=1; state<=11; end

            // 12-bit conversion
            11: begin sclk<=0; state<=12; end
            12: begin sclk<=1; shift_reg[11]<=miso; state<=13; end

            13: begin sclk<=0; state<=14; end
            14: begin sclk<=1; shift_reg[10]<=miso; state<=15; end

            15: begin sclk<=0; state<=16; end
            16: begin sclk<=1; shift_reg[9]<=miso; state<=17; end

            17: begin sclk<=0; state<=18; end
            18: begin sclk<=1; shift_reg[8]<=miso; state<=19; end

            19: begin sclk<=0; state<=20; end
            20: begin sclk<=1; shift_reg[7]<=miso; state<=21; end

            21: begin sclk<=0; state<=22; end
            22: begin sclk<=1; shift_reg[6]<=miso; state<=23; end

            23: begin sclk<=0; state<=24; end
            24: begin sclk<=1; shift_reg[5]<=miso; state<=25; end

            25: begin sclk<=0; state<=26; end
            26: begin sclk<=1; shift_reg[4]<=miso; state<=27; end

            27: begin sclk<=0; state<=28; end
            28: begin sclk<=1; shift_reg[3]<=miso; state<=29; end

            29: begin sclk<=0; state<=30; end
            30: begin sclk<=1; shift_reg[2]<=miso; state<=31; end

            31: begin sclk<=0; state<=32; end
            32: begin sclk<=1; shift_reg[1]<=miso; state<=33; end

            33: begin sclk<=0; state<=34; end
            34: begin sclk<=1; shift_reg[0]<=miso; state<=35; end

            35:
            begin
                cs_n <= 1;
                sclk <= 0;
                adc_data <= shift_reg;
                data_valid <= 1'b1;
                state <= 0;
            end

            default:
                state <= 0;

            endcase
        end
        else
            clk_div <= clk_div + 1;
    end
end

endmodule
