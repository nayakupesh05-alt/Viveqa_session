module uart_rx
#(
    parameter CLK_FREQ  = 24000000,
    parameter BAUD_RATE = 115200
)
(
    input  wire clk,
    input  wire rst,
    input  wire rx,

    output reg [7:0] rx_data,
    output reg       rx_done
);

localparam CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;

reg [15:0] clk_cnt;
reg [3:0]  bit_index;
reg [7:0]  rx_shift;
reg [2:0]  state;

always @(posedge clk or posedge rst) begin
    if (rst) begin
        state     <= 0;
        clk_cnt   <= 0;
        bit_index <= 0;
        rx_done   <= 0;
        rx_data   <= 0;
    end
    else begin
        rx_done <= 0;

        case (state)
            0: begin // Idle
                if (rx == 0) begin
                    clk_cnt <= CLKS_PER_BIT/2;
                    state   <= 1;
                end
            end

            1: begin // Middle of start bit
                if (clk_cnt == 0) begin
                    clk_cnt   <= CLKS_PER_BIT-1;
                    bit_index <= 0;
                    state     <= 2;
                end else
                    clk_cnt <= clk_cnt - 1;
            end

            2: begin // Receive 8 bits
                if (clk_cnt == 0) begin
                    rx_shift[bit_index] <= rx;
                    clk_cnt <= CLKS_PER_BIT-1;
                    if (bit_index == 7)
                        state <= 3;
                    else
                        bit_index <= bit_index + 1;
                end else
                    clk_cnt <= clk_cnt - 1;
            end

            3: begin // Stop bit
                if (clk_cnt == 0) begin
                    rx_data <= rx_shift;
                    rx_done <= 1'b1;
                    state   <= 0;
                end else
                    clk_cnt <= clk_cnt - 1;
            end

            default: state <= 0;
        endcase
    end
end

endmodule
