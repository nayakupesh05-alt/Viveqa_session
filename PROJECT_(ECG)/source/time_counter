module time_counter (
    input  wire       clk,
    input  wire       rst,
    output reg  [3:0] hour2, // Hours tens   (0)
    output reg  [3:0] hour1, // Hours ones   (4)
    output reg  [3:0] min2,  // Minutes tens (1)
    output reg  [3:0] min1,  // Minutes ones (8)
    output reg  [3:0] sec2,
    output reg  [3:0] sec1,
    output reg        day_tick
);

    // 1-second tick generator from 24 MHz clock
    reg [24:0] sec_counter;
    wire sec_tick = (sec_counter == 25'd23_999_999);

    always @(posedge clk) begin
        if (rst)
            sec_counter <= 25'd0;
        else if (sec_tick)
            sec_counter <= 25'd0;
        else
            sec_counter <= sec_counter + 1'b1;
    end

    always @(posedge clk) begin
        if (rst) begin
            // Preset directly to 04:18:00
            hour2    <= 4'd1;
            hour1    <= 4'd2;
            min2     <= 4'd5;
            min1     <= 4'd5;
            sec2     <= 4'd0;
            sec1     <= 4'd0;
            day_tick <= 1'b0;
        end else if (sec_tick) begin
            day_tick <= 1'b0;
            
            if (sec1 < 4'd9) begin
                sec1 <= sec1 + 1'b1;
            end else begin
                sec1 <= 4'd0;
                if (sec2 < 4'd5) begin
                    sec2 <= sec2 + 1'b1;
                end else begin
                    sec2 <= 4'd0;
                    // Minutes increment
                    if (min1 < 4'd9) begin
                        min1 <= min1 + 1'b1;
                    end else begin
                        min1 <= 4'd0;
                        if (min2 < 4'd5) begin
                            min2 <= min2 + 1'b1;
                        end else begin
                            min2 <= 4'd0;
                            // Hours increment
                            if (hour2 == 4'd2 && hour1 == 4'd3) begin
                                hour2    <= 4'd0;
                                hour1    <= 4'd0;
                                day_tick <= 1'b1; // Trigger next date
                            end else if (hour1 < 4'd9) begin
                                hour1 <= hour1 + 1'b1;
                            end else begin
                                hour1 <= 4'd0;
                                hour2 <= hour2 + 1'b1;
                            end
                        end
                    end
                end
            end
        end
    end

endmodule
