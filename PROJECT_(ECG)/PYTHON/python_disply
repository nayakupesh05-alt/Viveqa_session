# -----------------------------
# PQRST Detection
# -----------------------------
def detect_pqrst():

    global sample_count, last_r_sample

    data = np.array(sample_buffer)

    if len(data) < 100:
        sample_count += 1
        return

    sample_count += 1

    r_index = np.argmax(data)
    r_value = data[r_index]

    if r_value > R_THRESHOLD and (sample_count - last_r_sample) > REFRACTORY:

        last_r_sample = sample_count

        p_index = max(0, r_index - 40)
        q_index = max(0, r_index - 10)
        s_index = min(len(data)-1, r_index + 10)
        t_index = min(len(data)-1, r_index + 50)

        print("\n========== PQRST DETECTED ==========")
        print(f"Sample : {sample_count}")
        print(f"P : {data[p_index]}")
        print(f"Q : {data[q_index]}")
        print(f"R : {r_value}")
        print(f"S : {data[s_index]}")
        print(f"T : {data[t_index]}")
        print("====================================")




def filter_ecg(signal):

    if len(signal) < 100:
        return signal

    fs = 250.0

    # Remove baseline wander (0.5 Hz)
    b1, a1 = butter(2, 0.5/(fs/2), btype='high')
    signal = filtfilt(b1, a1, signal)

    # Remove 50 Hz power-line noise
    b2, a2 = iirnotch(50, 30, fs)
    signal = filtfilt(b2, a2, signal)

    # Low-pass filter (25 Hz)
    b3, a3 = butter(4, 25/(fs/2), btype='low')
    signal = filtfilt(b3, a3, signal)

    # Moving average
    signal = np.convolve(signal, np.ones(7)/7, mode='same')

    return signal

