# -----------------------------
# Update Function
# -----------------------------
rx = []
capture = ""

def update(frame):
    global capture, rx

    while ser.in_waiting > 0:

        b = ser.read(1)

        if len(b) == 0:
            continue

        byte = b[0]

        # -----------------------------
        # Check for CAPTURE command
        # -----------------------------
        if 65 <= byte <= 90:

            capture += chr(byte)
            
            

            if capture.endswith("CAPTURE"):
                print("Capture command received")
                

                detect_pqrst()
                save_plot()

                capture = ""

            continue

        # -----------------------------
        # ECG data (2-byte sample)
        # -----------------------------
        rx.append(byte)

        if len(rx) == 2:

            high = rx[0]
            low  = rx[1]

            sample = ((high & 0x0F) << 8) | low

            ecg.append(sample)
            sample_buffer.append(sample)

            # Print sample (optional)
            

            # Detect PQRST
            detect_pqrst()

            # Clear receive buffer
            rx.clear()

    # -----------------------------
    # Update ECG graph
    # -----------------------------
    filtered = filter_ecg(np.array(ecg))
    line.set_ydata(filtered)

    return line,
