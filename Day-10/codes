module vending(clk,rst,x,d,c);
input rst,clk;
input [1:0]x;
output reg d,c;

parameter s0=3'b000,s1=3'b001,s2=3'b010,s3=3'b011,s4=3'b100;
reg [2:0] current_state;
reg [2:0] next_state;
 always @(posedge clk or negedge rst) begin
       if (rst) begin
           current_state <= s0;
       end else begin
           current_state <= next_state;
       end
   end
   always @(*) begin
         
           next_state = current_state; 
           
           case (current_state)
                  s0    : begin
                  d=1'b0;c=1'b0;
                           if (x==2'b00)
                               next_state = s1;
                           else  if(x==2'b01)
                               next_state = s2;
                               else  
                               next_state=s0;
                       end
                       s1   : begin
                            d=1'b0;c=1'b0;
                             if (x==2'b01)
                                next_state = s2;
                                else  if(x==2'b10)
                                  next_state = s3;
                             else  
                          next_state=s1;
                           end
                s2   : begin
                          d=1'b0;c=1'b0;
                            if (x==2'b01)
                            next_state = s2;
                                else  if(x==2'b10)
                          next_state = s3;
                else  
           next_state=s1;
                       end
             s3   : begin
                           d=1'b1;c=1'b0;
                       
                           next_state = s0;
                                       
                                     end
     s4  : begin
              d=1'b1;c=1'b1;
         if (x==2'b01)
            next_state = s0;  
            end
       default: next_state =    s0;
       endcase
       end 
                                     endmodule


